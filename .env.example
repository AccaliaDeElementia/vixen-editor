# Copy to .env for local development. Every value here is the built-in default,
# so an empty .env behaves identically to no .env at all.
#
# In Docker these are supplied with `-e` / `--env-file` instead; real environment
# variables always win over .env, which is what makes the same image configurable
# across environments.

# Port the HTTP server listens on (1-65535).
PORT=3000

# Address to bind. 0.0.0.0 is required inside a container; 127.0.0.1 is a
# reasonable default for local-only development.
HOST=0.0.0.0

# Root directory for markdown documents. Mount a volume here in Docker.
DOCS_ROOT=./data/docs

# Directory holding the pug templates. The Docker image copies them to
# ./templates and sets this accordingly.
TEMPLATES_DIR=./src/templates

# One of: debug | info | warn | error
LOG_LEVEL=info

# One of: development | production | test
NODE_ENV=development

# Namespace filter for the `debug` logger. Loggers are scoped
# vixen-editor:MODULE[:FUNCTION], so you can narrow as far as you like:
#   vixen-editor:*                  everything, including the startup banner
#   vixen-editor:storage/*          just the document store
#   vixen-editor:app:onError        just unhandled request failures
# Unset means completely silent, which is what the test suite relies on.
DEBUG=vixen-editor:*
