{
  "name": "vixen-editor",
  "version": "0.1.0",
  "description": "A markdown editor built on Hono and CodeMirror 6",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=scripts scripts/dev.ts",
    "build": "node scripts/build.ts",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "pretest": "npm run format && npm run typecheck && npm run lint",
    "test": "npm run test:coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test -c test-browser/playwright.config.ts",
    "test:all": "npm test && npm run test:browser",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "debug": "^4.4.3",
    "dotenv": "^18.0.2",
    "hono": "^4.13.8",
    "micromark": "^4.0.2",
    "pug": "^3.0.4",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.63.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.2",
    "@types/pug": "^2.0.10",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^5.0.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-love": "^157.0.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
