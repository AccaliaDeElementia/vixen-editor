{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/server/**/*.ts",
    "test/server/**/*.ts",
    "test/conventions/**/*.ts",
    "scripts/**/*.ts"
  ]
}
