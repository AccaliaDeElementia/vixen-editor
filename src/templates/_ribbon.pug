nav.ribbon(aria-label='Primary')
  button.ribbon__button#nav-back(type='button' aria-label='Back' disabled aria-disabled='true')
    span.icon(aria-hidden='true') arrow_back
  button.ribbon__button#nav-forward(type='button' aria-label='Forward' disabled aria-disabled='true')
    span.icon(aria-hidden='true') arrow_forward
  button.ribbon__button#toggle-explorer(
    type='button'
    aria-label='Toggle file browser'
    aria-controls='explorer'
    aria-expanded='true'
    aria-pressed='true'
  )
    span.icon(aria-hidden='true') library_books
  button.ribbon__button#split-beside(type='button' aria-label='Split the editor side by side' aria-pressed='false')
    span.icon(aria-hidden='true') vertical_split
  button.ribbon__button#split-below(type='button' aria-label='Split the editor above and below' aria-pressed='false')
    span.icon(aria-hidden='true') horizontal_split
  button.ribbon__button#show-help(type='button' aria-label='Help' title='Help')
    span.icon(aria-hidden='true') help
