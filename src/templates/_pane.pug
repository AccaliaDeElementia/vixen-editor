mixin pane(primary)
  section.pane(data-part='pane')
    .tabs(data-part='tabs')
      button.tabs__scroll.tabs__scroll--before(data-part='tabs-before' type='button' aria-label='Show the tabs to the left')
        span.icon(aria-hidden='true') chevron_left
      .tabs__scroller(data-part='tabs-scroller' aria-label='Open documents')
      button.tabs__scroll.tabs__scroll--after(data-part='tabs-after' type='button' aria-label='Show the tabs to the right')
        span.icon(aria-hidden='true') chevron_right
      if primary
        .tabs__actions
          button.tabs__action(
            data-part='split-beside'
            type='button'
            aria-label='Split the editor side by side'
            title='Split the editor side by side'
            aria-pressed='false'
          )
            span.icon(aria-hidden='true') vertical_split
          button.tabs__action(
            data-part='split-below'
            type='button'
            aria-label='Split the editor above and below'
            title='Split the editor above and below'
            aria-pressed='false'
          )
            span.icon(aria-hidden='true') horizontal_split
    .controls(data-part='controls' role='toolbar' aria-label='Editing' hidden)
      button.control(
        data-part='edit-undo'
        type='button'
        aria-label='Undo'
        title='Undo'
      )
        span.icon(aria-hidden='true') undo
      button.control(
        data-part='edit-redo'
        type='button'
        aria-label='Redo'
        title='Redo'
      )
        span.icon(aria-hidden='true') redo
      button.control(
        data-part='edit-find'
        type='button'
        aria-label='Find and replace'
        title='Find and replace'
      )
        span.icon(aria-hidden='true') search
      span.control__divider(aria-hidden='true')
      button.control(
        data-part='format-bold'
        type='button'
        aria-label='Bold'
        title='Bold'
      )
        span.icon(aria-hidden='true') format_bold
      button.control(
        data-part='format-italic'
        type='button'
        aria-label='Italic'
        title='Italic'
      )
        span.icon(aria-hidden='true') format_italic
      button.control(data-part='format-strikethrough' type='button' aria-label='Strikethrough' title='Strikethrough')
        span.icon(aria-hidden='true') format_strikethrough
      button.control(
        data-part='format-code'
        type='button'
        aria-label='Code'
        title='Code'
      )
        span.icon(aria-hidden='true') code
      button.control(
        data-part='format-link'
        type='button'
        aria-label='Link'
        title='Link'
      )
        span.icon(aria-hidden='true') link
      span.control__divider(aria-hidden='true')
      button.control(data-part='format-heading' type='button' aria-label='Heading' title='Heading')
        span.icon(aria-hidden='true') title
      button.control(data-part='format-list' type='button' aria-label='List' title='List')
        span.icon(aria-hidden='true') format_list_bulleted
      button.control(data-part='format-quote' type='button' aria-label='Quote' title='Quote')
        span.icon(aria-hidden='true') format_quote
      .controls__end
        button.control(
          data-part='preview-markup'
          type='button'
          aria-label='Show the document rendered'
          title='Show the document rendered'
        )
          span.icon(aria-hidden='true') preview
        button.control(
          data-part='preview-source'
          type='button'
          aria-label='Show the HTML the preview renders'
          title='Show the HTML the preview renders'
        )
          span.icon(aria-hidden='true') code_blocks
    .pane__editor(data-part='editor' hidden tabindex='-1')&attributes(primary ? { id: 'editor' } : {})
    .footing(data-part='footing' hidden)
      span.footing__save(data-part='save-label' role='status')
      span.footing__countdown(data-part='save-countdown' aria-hidden='true')
      span.footing__words(data-part='word-count')
    section.view.view--fill(data-part='view-image' tabindex='-1' aria-label='Image' hidden)
      .image__chrome
        p.image__path(data-part='image-path')
        a.view__action(data-part='image-download' download data-default-action) Download
      .image__frame
        img.image__file(data-part='image-file' alt='')
    section.view.view--fill(data-part='view-source' tabindex='-1' aria-label='HTML' hidden)
      pre.source
        code.source__body(data-part='source-body')
    section.view.view--fill(data-part='view-markup' tabindex='-1' aria-label='Preview' hidden)
      article.markup(data-part='markup-body')
    section.view(data-part='view-empty' tabindex='-1' aria-label='Nothing open' hidden)
      p.view__message Open a document from the file browser to start editing.
    section.view(data-part='view-pending' tabindex='-1' aria-label='Loading' hidden)
      p.view__message Loading…
    section.view(data-part='view-missing' tabindex='-1' aria-label='Not found' hidden)
      h1.view__title Not found
      p.view__message
        | Nothing is stored at
        |
        code.view__path(data-part='missing-path')
      p.view__actions
        button.view__action(data-part='missing-create' type='button' data-default-action) Create it
        button.view__action(data-part='missing-upload' type='button') Upload a file
        input(data-part='missing-upload-input' type='file' hidden aria-hidden='true' tabindex='-1')
      section.view__restore(data-part='missing-restore' hidden aria-label='Restore from trash')
        h2.view__subtitle From the trash
        ul.restore(data-part='missing-restore-list')
    section.view(data-part='view-deleted' tabindex='-1' aria-label='Deleted' hidden)
      h1.view__title In the trash
      p.view__message(data-part='deleted-what')
      .restore-tree__host(data-part='deleted-contents' hidden)
      p.view__actions(data-part='deleted-actions')
        button.view__action(data-part='deleted-restore' type='button' data-default-action) Restore
        button.view__action.view__action--danger(data-part='deleted-purge' type='button') Delete for good
      p.view__message(data-part='deleted-blocked' hidden)
    section.view(data-part='view-unreachable' tabindex='-1' aria-label='Unreachable' hidden)
      h1.view__title Cannot reach the server
      p.view__message(data-part='unreachable-reason')
      p.view__actions
        button.view__action(data-part='unreachable-retry' type='button' data-default-action) Try again
