dialog.modal#file-dialog(aria-labelledby='file-dialog-title')
  //- Password managers strip separators from an id and substring-match the
      result, so this field must not spell a credential word by accident.
      "file-dialog-input" squashes to "filedialoginput", which contains
      "login", and Bitwarden offered to fill it. test/server/field-naming
      keeps that from coming back. The data attributes are each vendor's
      documented opt-out; data-bwignore is gone because it made no difference.
  .modal__form
    h2.modal__title#file-dialog-title
    p.modal__message#file-dialog-message
    p.modal__field#file-dialog-field
      label.modal__label#file-dialog-label(for='file-dialog-entry') Name
      input.modal__input#file-dialog-entry(
        type='text'
        name='vixen-entry'
        autocomplete='off'
        spellcheck='false'
        data-1p-ignore
        data-lpignore='true'
        data-form-type='other'
      )
    p.modal__error#file-dialog-error(role='alert')
    .modal__actions
      button.modal__button#file-dialog-cancel(type='button' value='cancel') Cancel
      button.modal__button.modal__button--primary#file-dialog-confirm(type='button' value='confirm')
