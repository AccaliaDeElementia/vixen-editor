aside.explorer#explorer(aria-label='Sidebar')
  section.panel(data-panel='files' aria-label='File browser')
    .explorer__toolbar(role='toolbar' aria-label='File actions')
      button.explorer__action#new-document(type='button' aria-label='New document' title='New document')
        span.icon(aria-hidden='true') note_add
      button.explorer__action#new-folder(type='button' aria-label='New folder' title='New folder')
        span.icon(aria-hidden='true') create_new_folder
      button.explorer__action#upload-file(type='button' aria-label='Upload' title='Upload')
        span.icon(aria-hidden='true') upload_file
      a.explorer__action#download-archive(href=archiveUrl aria-label='Download archive' title='Download archive')
        span.icon(aria-hidden='true') folder_zip
      button.explorer__action#delete-entry(type='button' aria-label='Delete' title='Delete')
        span.icon(aria-hidden='true') delete
      button.explorer__action#open-selected(type='button' aria-label='Open selected' title='Open selected')
        span.icon(aria-hidden='true') open_in_new
      button.explorer__action#reveal-document(type='button' aria-label='Reveal open document' title='Reveal open document')
        span.icon(aria-hidden='true') center_focus_strong
      button.explorer__action#insert-entry(
        type='button'
        aria-label='Insert a link to the selected file'
        title='Insert a link to the selected file'
        disabled
      )
        span.icon(aria-hidden='true') input
      input#upload-input(type='file' multiple hidden aria-hidden='true' tabindex='-1')
    ul.tree#file-tree(role='tree' aria-label='Documents')
  section.panel(data-panel='trash' aria-label='Trash' hidden)
    .explorer__toolbar(role='toolbar' aria-label='Trash actions')
      button.explorer__action#empty-trash(type='button' aria-label='Empty the trash' title='Empty the trash')
        span.icon(aria-hidden='true') delete_sweep
    p.panel__empty(data-part='trash-empty' hidden)
      | Nothing has been deleted. What you delete is kept here until you empty the trash.
    ul.tree#trash-list(role='tree' aria-label='Deleted entries')
button.explorer__resizer#explorer-resizer(
  type='button'
  role='separator'
  aria-orientation='vertical'
  aria-label='Resize file browser'
)
