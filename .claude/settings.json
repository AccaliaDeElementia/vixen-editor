{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch --list:*)",
      "Bash(git stash list:*)",
      "Bash(git stash show:*)",
      "Bash(git remote -v)",
      "Bash(git rev-parse:*)",
      "Bash(git describe:*)",
      "Bash(git ls-files:*)",
      "Bash(git shortlog:*)"
    ],
    "deny": [
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
      "Bash(git --exec-path:*)",

      "Bash(git commit)",
      "Bash(git commit:*)",
      "Bash(git add)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git reset)",
      "Bash(git reset:*)",
      "Bash(git restore)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",

      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git pull)",
      "Bash(git pull:*)",
      "Bash(git fetch)",
      "Bash(git fetch:*)",
      "Bash(git remote add:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rename:*)",
      "Bash(git remote set-url:*)",

      "Bash(git checkout)",
      "Bash(git checkout:*)",
      "Bash(git switch)",
      "Bash(git switch:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -m:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch --move:*)",

      "Bash(git stash)",
      "Bash(git stash push:*)",
      "Bash(git stash save:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash apply:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash store:*)",

      "Bash(git merge)",
      "Bash(git merge:*)",
      "Bash(git rebase)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git am:*)",
      "Bash(git apply:*)",
      "Bash(git tag -a:*)",
      "Bash(git tag -d:*)",
      "Bash(git tag -f:*)",
      "Bash(git update-ref:*)",
      "Bash(git filter-branch:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release create:*)"
    ]
  }
}
